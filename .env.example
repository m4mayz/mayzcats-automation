# Custom OpenAI-compatible chat-completions endpoint. The model name is not a secret:
# set it as llm.model in config/pipeline.yaml.
# API keys accept a comma-separated list; keys are tried in order on quota or auth rejection.
OPENAI_BASE_URL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Comma-separated. Keys are attempted in order and never written to logs.
ELEVENLABS_API_KEYS=

PEXELS_API_KEY=
PIXABAY_API_KEY=
TAVILY_API_KEY=
